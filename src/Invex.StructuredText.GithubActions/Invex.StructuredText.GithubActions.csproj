<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageDescription>Strongly-typed C# models for generating GitHub Actions workflows and Dependabot configurations as YAML</PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dunet" Version="1.16.2" />
    <PackageReference Include="Invex.RepoUtils.PublicApiAnalyzers" Version="2.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Roslynator.Analyzers" Version="5.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Formatting.Analyzers" Version="5.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Invex.StructuredText\Invex.StructuredText.csproj" />
    <ProjectReference Include="..\Invex.StructuredText.Generators\Invex.StructuredText.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Contexts\github.contexts" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Invex.StructuredText.GithubActions.props" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

</Project>