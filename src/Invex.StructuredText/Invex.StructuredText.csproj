<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageDescription>Core library for Structured Text: the StructuredTextWriter and the unified expression system used to generate structured YAML text files</PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Invex.RepoUtils.PublicApiAnalyzers" Version="3.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Roslynator.Analyzers" Version="5.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Formatting.Analyzers" Version="5.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Expressions\TextExpression.WorkflowRun.cs">
      <DependentUpon>TextExpression.cs</DependentUpon>
    </Compile>
    <Compile Update="Expressions\TextExpression.Functions.cs">
      <DependentUpon>TextExpression.cs</DependentUpon>
    </Compile>
    <Compile Update="Expressions\TextExpression.Values.cs">
      <DependentUpon>TextExpression.cs</DependentUpon>
    </Compile>
    <Compile Update="Expressions\TextExpression.LogicOperators.cs">
      <DependentUpon>TextExpression.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Include="Invex.StructuredText.props" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

</Project>